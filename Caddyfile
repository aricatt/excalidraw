:443 {
    # 使用自签名证书 (允许通过 IP 访问)
    tls internal

    # 后端 API 代理
    reverse_proxy /api/* excalidraw-backend:6601
    reverse_proxy /socket.io/* excalidraw-backend:6601

    # 语音服务代理
    reverse_proxy /voice/* excalidraw-voice:4408

    # 前端代理 (兜底所有其他请求)
    reverse_proxy * excalidraw-frontend:80
}
