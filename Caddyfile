# 全局配置
{
    # 自动 HTTPS 邮箱 (用于 Let's Encrypt 通知)
    email your-email@example.com
}

# 你的域名配置 (请替换为实际域名，如 draw.example.com)
# 如果暂时没有域名，可以使用 localhost 测试 (但只能在本地访问)
# localhost {
YOUR_DOMAIN.com {
    # 1. 前端服务
    handle / {
        reverse_proxy frontend:80
    }
    handle /* {
        reverse_proxy frontend:80
    }

    # 2. 后端 API 服务
    handle /api/* {
        reverse_proxy backend:6601
    }

    # 3. 语音服务
    handle /voice/* {
        # 注意：这里需要确保前端请求语音服务时使用 /voice 前缀
        # 或者如果语音服务有自己的路径前缀，直接代理
        reverse_proxy voice-service:4408
    }

    # 启用 gzip 压缩
    encode gzip

    # 安全头
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
