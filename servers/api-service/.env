# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/excalidraw_plus_dev"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/excalidraw_plus_test"

# JWT Secret (change this to a random string)
JWT_SECRET="your-random-jwt-secret-key-change-this-in-production"

# Server Configuration
PORT=6602  
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN="http://localhost:4417"

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR="./uploads"

# Redis (Optional - for caching and real-time features)
REDIS_URL="redis://localhost:6379"

# Email Service (Optional - for user verification)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
