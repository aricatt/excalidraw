# Database - 阿里云 RDS MySQL
# 格式: mysql://用户名:密码@RDS地址:端口/数据库名
# 示例: DATABASE_URL="mysql://excalidraw:your_password@rm-xxxxx.mysql.rds.aliyuncs.com:3306/excalidraw_plus"
DATABASE_URL="mysql://username:password@localhost:3306/excalidraw_plus"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=6601  
NODE_ENV=development

# CORS Configuration
# 本地开发使用 localhost，生产环境使用实际域名
CORS_ORIGIN="https://localhost,https://your-domain.com"

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR="./uploads"

# Redis (可选 - 用于缓存和实时功能)
# 本地开发: redis://localhost:6379
# 阿里云 Redis: redis://:password@r-xxxxx.redis.rds.aliyuncs.com:6379
REDIS_URL="redis://localhost:6379"

# Email Service (可选 - 用于用户验证)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

