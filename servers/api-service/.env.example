# Database
DATABASE_URL="postgresql://username:password@localhost:5432/excalidraw_plus"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN="http://localhost:4417"

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR="./uploads"

# Redis (Optional - for caching and real-time features)
REDIS_URL="redis://localhost:6379"

# Email Service (Optional - for user verification)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
