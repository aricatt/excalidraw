// Prisma schema for Excalidraw Plus API Service
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  password    String
  avatar      String?
  preferences Json?    // 用户偏好设置 (theme, language)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  drawings           Drawing[]
  sessions           Session[]
  collaborations     Collaboration[]
  files              File[]
  ownedWorkspaces    Workspace[]
  workspaceMemberships WorkspaceMember[]
  workspaceInvitations WorkspaceInvitation[]

  @@map("users")
}

// 会话表 (JWT 黑名单管理)
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// 工作空间表
model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  ownerId     String
  settings    Json?    // AI 偏好、公开访问等设置
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  collections Collection[]
  aiPreferences AIPreferences?

  @@map("workspaces")
}

// 工作空间成员表
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   // "owner" | "admin" | "member" | "viewer"
  joinedAt    DateTime @default(now())
  invitedBy   String?

  // 关联关系
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// 工作空间邀请表
model WorkspaceInvitation {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   // "admin" | "member" | "viewer"
  token       String   @unique
  expiresAt   DateTime
  invitedBy   String
  status      String   @default("pending") // "pending" | "accepted" | "expired"
  createdAt   DateTime @default(now())

  // 关联关系
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation(fields: [invitedBy], references: [id])

  @@map("workspace_invitations")
}

// 集合表
model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  workspaceId String
  ownerId     String
  isDefault   Boolean  @default(false) // Private, Main 等默认集合
  visibility  String   @default("private") // "private" | "team" | "public"
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  drawings  Drawing[]

  @@map("collections")
}

// 绘图数据表
model Drawing {
  id          String   @id @default(cuid())
  title       String
  description String?
  content     Json     // Excalidraw 原生 JSON 数据 (elements + appState)
  thumbnail   String?  @db.LongText // 缩略图 URL (支持 Base64 大图)
  isPublic    Boolean  @default(false)
  version     Int      @default(1) // 版本控制
  workspaceId String?
  collectionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  // 关联关系
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection    Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  collaborations Collaboration[]
  tags          DrawingTag[]
  exports       DrawingExport[] // 导出文件关联
  comments      Comment[]       // 评论关联

  @@map("drawings")
}

// 评论表
model Comment {
  id        String   @id @default(cuid())
  drawingId String
  userId    String
  userName  String   // 冗余字段，避免每次都 join User 表
  content   String   @db.Text
  x         Float?   // 画布 X 坐标
  y         Float?   // 画布 Y 坐标
  elementId String?  // 可选：关联到特定元素
  parentId  String?  // 可选：回复功能
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联关系
  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@index([drawingId])
  @@index([parentId])
  @@map("comments")

}

// 协作表
model Collaboration {
  id         String   @id @default(cuid())
  drawingId  String
  userId     String
  permission String   // "read" | "write" | "admin"
  createdAt  DateTime @default(now())

  // 关联关系
  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([drawingId, userId])
  @@map("collaborations")
}

// 标签表
model Tag {
  id       String @id @default(cuid())
  name     String @unique
  color    String @default("#6366f1")
  
  // 关联关系
  drawings DrawingTag[]

  @@map("tags")
}

// 绘图标签关联表
model DrawingTag {
  drawingId String
  tagId     String

  // 关联关系
  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([drawingId, tagId])
  @@map("drawing_tags")
}

// 绘图导出文件表
model DrawingExport {
  id        String   @id @default(cuid())
  drawingId String
  format    String   // "png", "svg", "pdf", "json"
  filename  String
  fileData  Bytes?   // 二进制文件数据 (小文件直接存储)
  fileUrl   String?  // 文件 URL (大文件存储到云端)
  fileSize  Int
  width     Int?     // 导出尺寸
  height    Int?
  scale     Float?   // 导出缩放比例
  quality   Float?   // 导出质量 (PNG/JPG)
  createdAt DateTime @default(now())

  // 关联关系
  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@map("drawing_exports")
}

// 通用文件存储表
model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String   // 文件存储路径
  userId       String   // 文件所有者
  createdAt    DateTime @default(now())

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("files")
}

// AI 偏好设置表
model AIPreferences {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  aiEnabled   Boolean  @default(false)
  services    Json?    // { speechRecognition: true, textGeneration: false, ... }
  privacy     Json?    // { dataSharing: false, localProcessing: true, ... }
  quotas      Json?    // { dailyRequests: 100, monthlyRequests: 3000, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ai_preferences")
}

// AI 使用日志表
model AIUsageLog {
  id             String   @id @default(cuid())
  workspaceId    String
  userId         String
  feature        String   // "speech_recognition" | "text_generation" | "layout_optimization"
  requestData    Json?
  responseData   Json?
  processingTime Int?     // 毫秒
  cost           Float?   // 费用（如果有）
  timestamp      DateTime @default(now())

  @@map("ai_usage_logs")
}
